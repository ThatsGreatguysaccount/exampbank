DATABASE_URL="mysql://root:@127.0.0.1:3306/prairie_bank"
SESSION_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# IP allowlist (Admin → Settings → Network access).
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_HOPS="1"
# Emergency switch: set to "true" and restart to ignore the allowlist if you lock yourself out.
IP_ALLOWLIST_BYPASS="false"
